  <string name="settings.locked">Verrouillé</string>
  <string name="settings.lockedHint">Verrouillé : non effacé ni évincé ; cliquez pour déverrouiller</string>
  <string name="settings.lockedNoDelete">Les entrées verrouillées ne peuvent pas être supprimées ; déverrouillez d'abord</string>
  <string name="settings.maxRender">Limite d'affichage du journal (lignes)</string>
  <string name="settings.maxRenderDesc">Seules les N dernières lignes filtrées sont affichées. Augmentez pour une journalisation rapide ; une valeur plus élevée crée plus de nœuds DOM et peut ralentir l'interface. Les modifications s'appliquent immédiatement et sont enregistrées.</string>
