  <string name="settings.appLog">Chemin du journal de l'application</string>
  <string name="settings.appLogDesc">Si activé, les journaux de l'application (sortie console et exceptions non interceptées) sont ajoutés à {dir}/app.log avec horodatage et niveau. Si désactivé, la sortie va uniquement dans la console.</string>
  <string name="settings.appLogHint">Écrire les journaux de débogage de l'application dans le répertoire ci-dessous</string>
  <string name="settings.autoLog">Sauvegarde auto du journal</string>
  <string name="settings.autoLogDesc">Si activé, les journaux de chaque appareil sont écrits par jour dans {dir}/logcat_&lt;modèle_numérodesérie&gt;_yyyyMMddHHmmss.log : le nom de fichier inclut le modèle et le numéro de série pour distinguer les appareils, un fichier par jour. L'écriture se fait de façon asynchrone en arrière-plan.</string>
  <string name="settings.autoLogHint">Sauvegarde automatique des journaux sur le disque (un fichier par appareil)</string>
  <string name="settings.builtin">Intégré</string>
  <string name="settings.capture">Paramètres de capture</string>
  <string name="settings.captureDeviceDir">Chemin de capture sur l'appareil</string>
  <string name="settings.captureDeviceDirDesc">Répertoire de capture côté appareil (chemin Android), par défaut /sdcard/adbpp_captures/. Les modifications s'appliquent immédiatement à la capture suivante.</string>
  <string name="settings.captureLocalDir">Répertoire de sauvegarde local</string>
  <string name="settings.captureLocalDirDesc">Les pcaps téléchargés sont placés ici ; si vide, {dir}/captures est utilisé.</string>
  <string name="settings.captureRoot">Exécuter tcpdump en root (su -c)</string>
  <string name="settings.captureRootDesc">Désactivé par défaut ; tcpdump s'exécute dans un shell normal. Sur les appareils où adbd n'est pas root et où tcpdump manque de permissions (erreur de permission), activez cette option pour n'élever que tcpdump via su -c (sans redémarrer adbd). Nécessite un appareil rooté disposant de su.</string>
  <string name="settings.checkUpdate">Vérifier les mises à jour au démarrage (activé par défaut)</string>
  <string name="settings.closeOnOuter">Autoriser la fermeture des fenêtres en cliquant à l'extérieur (désactivé par défaut)</string>
  <string name="settings.closeOnOuterDesc">Si activé, un clic sur le masque à l'extérieur d'une fenêtre la ferme. Sinon, utilisez Annuler ou ×.</string>
  <string name="settings.colors">Couleurs des niveaux</string>
  <string name="settings.colorsHint">Définir couleur du texte / gras / arrière-plan par niveau de journal. L'arrière-plan est désactivé par défaut.</string>
  <string name="settings.configPath">Chemin du fichier de configuration</string>
  <string name="settings.configPathDesc">Emplacement personnalisé de adbtool-config.json (chemin complet du fichier, nom inclus). Laissez vide pour l'emplacement par défaut. Les changements prennent effet après redémarrage ; utile pour les répertoires inscriptibles ou les disques cloud. Actuel : {path}.</string>
  <string name="settings.contentColor">Couleurs du contenu du journal</string>
  <string name="settings.contentColorDesc">Colorer les lignes du journal par mot-clé. La correspondance Tag/contenu suit les filtres Tag/mot-clé de la fenêtre de journal. La couleur d'une règle prime sur la couleur de niveau. Les règles sont persistées avec la configuration.</string>
  <string name="settings.cursorDesc">Si activé et qu'un curseur est présent dans la zone de journal (après un clic), les flèches déplacent le curseur au lieu de faire défiler : gauche/droite passent d'une ligne à l'autre, haut/bas font défiler aux limites. Si désactivé, les flèches font défiler la fenêtre. N'affecte que le cas « curseur dans le journal ».</string>
  <string name="settings.cursorNoScroll">Déplacer le curseur sans faire défiler la fenêtre du journal (activé par défaut)</string>
  <string name="settings.defaultConfigPath">(par défaut : adbtool-config.json à côté de l'exe/à la racine du projet)</string>
  <string name="settings.deleteEntry">Supprimer l'entrée</string>
  <string name="settings.effectiveImmediately">Les modifications s'appliquent immédiatement et sont enregistrées.</string>
  <string name="settings.exportSettings">Exporter les paramètres</string>
  <string name="settings.exportTemplate">Exporter le modèle de langue</string>
  <string name="settings.external">Externe</string>
  <string name="settings.filterHistory">Historique des filtres</string>
  <string name="settings.filterHistoryDesc">Appuyez sur Entrée ou quittez un champ de filtre (avec des modifications) pour enregistrer son texte dans l'historique ; le plus récent en premier. Cliquez sur la flèche à gauche du champ pour choisir une entrée. Les entrées verrouillées ne sont jamais effacées ni évincées ; la limite ne s'applique pas à elles.</string>
  <string name="settings.font">Police du journal</string>
  <string name="settings.fontFamily">Police de caractères</string>
  <string name="settings.fontPlaceholder">Saisir pour filtrer les polices</string>
  <string name="settings.fontSize">Taille de la police</string>
  <string name="settings.general">Général</string>
  <string name="settings.historyAdd">Ajouter un manuellement</string>
  <string name="settings.historyClear">Effacer (conserver les verrouillées)</string>
