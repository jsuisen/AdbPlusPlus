  <string name="settings.screenshot">Paramètres de capture d'écran</string>
  <string name="settings.screenshotDir">Répertoire des captures d'écran</string>
  <string name="settings.screenshotDirDesc">Répertoire de sauvegarde des captures « vers un chemin » et « démarrer/arrêter » (par défaut : à côté de adb++.exe). Les fichiers sont nommés screenshot_YYYYMMDDHHMMSS_&lt;serial&gt;.png, un fichier par image pour un tri facile par date.</string>
  <string name="settings.screenshotInterval">Intervalle des captures d'écran</string>
  <string name="settings.shotIntervalDesc">Seul le mode continu « démarrer/arrêter » utilise cet intervalle ; « capture vers un chemin » est une capture unique et immédiate qui l'ignore.</string>
